    <!-- Onboarding -->
    <string name="ob_welcome_title">A calmer TV home</string>
    <string name="ob_welcome_body">Vitrum is a fast, private launcher for Fire TV, Android TV and Google TV. Glass panels, soft light, and everything reachable with your remote.</string>
    <string name="ob_privacy">No accounts. No analytics. Only GitHub and Open-Meteo (if you enable weather).</string>
    <string name="ob_style_title">Make it yours</string>
    <string name="ob_style_body">Pick a background and accent. You can change everything later in Settings.</string>
    <string name="ob_launcher_title">Set as your Home app</string>
    <string name="ob_launcher_body">Android TV lets you choose Vitrum as the Home app. Fire OS does not; Vitrum will still be available from your apps list.</string>
    <string name="ob_calibration_title">Fit the edges</string>
    <string name="ob_calibration_body">Use the arrow keys to adjust the safe margins until the dashed frame is fully visible on your TV.</string>
